@inject ILanguageService Lang

<Section Id="experience" Title="@Lang.Label("experience")">
    @foreach (var item in Items)
    {
        <div class="entry">
            <h3>@Lang.T(item.Role) · @item.Company</h3>
            <span class="period">@item.StartYear – @(item.EndYear?.ToString() ?? Lang.Label("present"))</span>
            <p>@Lang.T(item.Description)</p>
        </div>
    }
</Section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Experience> Items { get; set; } = Array.Empty<Experience>();
}
