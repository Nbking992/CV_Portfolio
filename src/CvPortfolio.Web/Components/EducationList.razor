@inject ILanguageService Lang

<Section Id="education" Title="@Lang.Label("education")" Prompt="@Lang.Label("prompt.education")">
    <div class="grid">
        @foreach (var item in Items)
        {
            <article class="card edu-card">
                <span class="edu-period">@item.StartYear → @(item.EndYear?.ToString() ?? Lang.Label("present"))</span>
                <h3>@Lang.T(item.Title)</h3>
                <p class="org">@item.Institution</p>
            </article>
        }
    </div>
</Section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Education> Items { get; set; } = Array.Empty<Education>();
}
