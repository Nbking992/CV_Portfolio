@inherits LayoutComponentBase
@implements IDisposable
@inject ILanguageService Lang
@inject ICvService Cv
@inject IJSRuntime JS

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="#about">
            <span class="accent" aria-hidden="true">~/</span><span class="brand-full">@BrandFull</span><span class="brand-short">@BrandShort</span>
        </a>

        <nav class="top-nav" aria-label="@Lang.Label("navSections")">
            @foreach (var entry in Sections)
            {
                <a href="#@entry.Id">@Lang.Label($"nav.{entry.Id}")</a>
            }
        </nav>

        <div class="topbar-actions">
            <LanguageSwitcher />
            <ThemeToggle />
        </div>
    </div>
</header>

<div class="page">
    @Body
</div>

<footer class="footer">
    © @DateTime.Now.Year @Cv.GetProfile().FullName · @Lang.Label("footer")
</footer>

<nav class="bottom-nav" aria-label="@Lang.Label("navSections")">
    @foreach (var entry in Sections)
    {
        <a href="#@entry.Id" aria-label="@Lang.Label(entry.Id)">
            <Icon Name="@entry.Icon" />
            <span class="label">@Lang.Label(entry.Id)</span>
        </a>
    }
</nav>

@code {
    // Debe coincidir con los ids de sección y con el orden visual de la página.
    private static readonly (string Id, string Icon)[] Sections =
    {
        ("about", "user"),
        ("projects", "folder"),
        ("experience", "briefcase"),
        ("education", "cap"),
        ("skills", "star"),
    };

    private string BrandFull => string.Join("-", Names).ToLowerInvariant();

    // «Federico Bonaldo» -> «fbonaldo»
    private string BrandShort => Names.Length > 1
        ? $"{Names[0][0]}{Names[^1]}".ToLowerInvariant()
        : BrandFull;

    private string[] Names => Cv.GetProfile().FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

    protected override void OnInitialized() => Lang.Changed += OnLanguageChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await SyncHtmlLangAsync();
    }

    private void OnLanguageChanged()
    {
        _ = SyncHtmlLangAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    // Mantiene <html lang> en sintonía con el idioma elegido (lectores de pantalla, traductores).
    private async Task SyncHtmlLangAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cvTheme.setLang", Lang.Current == Language.En ? "en" : "es");
        }
        catch (JSException)
        {
            // Sin JS no pasa nada: la página sigue funcionando.
        }
    }

    public void Dispose() => Lang.Changed -= OnLanguageChanged;
}
