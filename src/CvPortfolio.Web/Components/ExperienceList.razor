@inject ILanguageService Lang

<Section Id="experience" Title="@Lang.Label("experience")" Prompt="@Lang.Label("prompt.experience")">
    <div class="stack">
        @foreach (var item in Items)
        {
            <article class="card exp-card">
                <div class="exp-head">
                    <div>
                        <h3>@Lang.T(item.Role)</h3>
                        <p class="org">@item.Company</p>
                    </div>
                    <span class="period">@item.StartYear → @(item.EndYear?.ToString() ?? Lang.Label("present"))</span>
                </div>
                <ul class="bullets">
                    @foreach (var bullet in item.Bullets)
                    {
                        <li><span class="chev" aria-hidden="true">&gt;</span><span>@Lang.T(bullet)</span></li>
                    }
                </ul>
            </article>
        }
    </div>
</Section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Experience> Items { get; set; } = Array.Empty<Experience>();
}
