<section id="@Id" class="@Css">
    @if (!string.IsNullOrEmpty(Prompt))
    {
        <p class="prompt" aria-hidden="true">@Prompt</p>
    }
    <h2><span class="accent" aria-hidden="true">~/</span>@Title</h2>
    @ChildContent
</section>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Línea tipo terminal que va sobre el título (por ejemplo «$ ls ./proyectos»).</summary>
    [Parameter] public string? Prompt { get; set; }

    /// <summary>Clases extra para la sección (por ejemplo «card» para dibujarla como tarjeta).</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Css => string.IsNullOrWhiteSpace(Class) ? "section" : $"section {Class}";
}
