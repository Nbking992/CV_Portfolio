@inject ILanguageService Lang

<section id="about" class="hero">
    <h1>@Profile.FullName</h1>
    <p class="headline">@Lang.T(Profile.Headline)</p>
    <p>@Lang.T(Profile.Summary)</p>
    @if (Profile.Highlights is { Count: > 0 })
    {
        <ul class="highlights">
            @foreach (var item in Profile.Highlights)
            {
                <li>@Lang.T(item)</li>
            }
        </ul>
    }
    <ul class="links">
        <li><a href="mailto:@Profile.Email">@Profile.Email</a></li>
        <li>@Profile.Location</li>
        @if (Profile.GitHubUrl is not null)
        {
            <li><a href="@Profile.GitHubUrl" target="_blank" rel="noopener">GitHub</a></li>
        }
        @if (Profile.LinkedInUrl is not null)
        {
            <li><a href="@Profile.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a></li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = default!;
}
